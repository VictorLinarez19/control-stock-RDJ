# Copiar a .env y completar.

# Desarrollo local (ver README): postgres corriendo en Docker en el puerto 5433.
# En produccion (Vercel + Neon): DATABASE_URL es la connection string CON pooler
# (host con "-pooler"), DIRECT_URL es la conexion directa, usada por las migraciones.
DATABASE_URL="postgresql://stock:stock@localhost:5433/stock?schema=public"
DIRECT_URL="postgresql://stock:stock@localhost:5433/stock?schema=public"

# Clave para entrar al sistema.
APP_PASSWORD=""

# Secreto para firmar la cookie de sesion. Cualquier cadena larga y aleatoria,
# por ejemplo generada con: openssl rand -hex 32
SESSION_SECRET=""
